{
  "name": "smashcart",
  "version": "0.1.0",
  "description": "SmashCart — local Wi-Fi only 3D plane combat arena (Express + ws + Three.js)",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build-client && tsc",
    "start": "node dist/index.js",
    "gen-audio": "node scripts/gen-audio.mjs",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build-client": "node scripts/build-client.mjs",
    "build-apk": "node scripts/build-apk.mjs",
    "host": "node scripts/host.js"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "bonjour-service": "^1.4.4",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "qrcode-terminal": "^0.12.0",
    "three": "^0.184.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
