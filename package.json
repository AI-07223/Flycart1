{
  "name": "smashcart",
  "version": "0.1.0",
  "description": "SmashCart — online 3D plane combat arena (Colyseus + Three.js)",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build-client && tsc",
    "start": "node dist/index.js",
    "vendor": "node scripts/vendor-three-addons.mjs",
    "gen-audio": "node scripts/gen-audio.mjs",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build-client": "node scripts/build-client.mjs"
  },
  "dependencies": {
    "@colyseus/monitor": "^0.16.0",
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.16.0",
    "@sentry/node": "^10.57.0",
    "colyseus": "^0.16.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "colyseus.js": "^0.16.22",
    "esbuild": "^0.24.2",
    "three": "^0.184.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
