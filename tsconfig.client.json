{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "three": ["./public/vendor/three.module.min.js"],
      "three/addons/*": ["./public/vendor/jsm/*"]
    }
  },
  "include": ["src/client/**/*"]
}
